(version 1)
# Generated by hw/gen_pcb.py. Mains creepage/clearance from the design spec.
(rule "mains to low voltage"
  (condition "(((A.NetClass == 'MAINS_L' || A.NetClass == 'MAINS_N' || A.NetClass == 'MAINS_DIV' || A.NetClass == 'RELAY1' || A.NetClass == 'RELAY2') && !(B.NetClass == 'MAINS_L' || B.NetClass == 'MAINS_N' || B.NetClass == 'MAINS_DIV' || B.NetClass == 'RELAY1' || B.NetClass == 'RELAY2')) || ((B.NetClass == 'MAINS_L' || B.NetClass == 'MAINS_N' || B.NetClass == 'MAINS_DIV' || B.NetClass == 'RELAY1' || B.NetClass == 'RELAY2') && !(A.NetClass == 'MAINS_L' || A.NetClass == 'MAINS_N' || A.NetClass == 'MAINS_DIV' || A.NetClass == 'RELAY1' || A.NetClass == 'RELAY2')))")
  (constraint clearance (min 6.5mm))
  (constraint creepage (min 6.5mm))
)
(rule "L to N"
  (condition "(((A.NetClass == 'MAINS_L') && (B.NetClass == 'MAINS_N')) || ((A.NetClass == 'MAINS_N') && (B.NetClass == 'MAINS_L')))")
  (constraint clearance (min 4mm))
  (constraint creepage (min 4mm))
)
(rule "L to N inside rated parts (5.08 mm terminal, HLK-PM01 pins)"
  (condition "(((A.NetClass == 'MAINS_L') && (B.NetClass == 'MAINS_N')) || ((A.NetClass == 'MAINS_N') && (B.NetClass == 'MAINS_L'))) && ((A.memberOfFootprint('J1') && B.memberOfFootprint('J1')) || (A.memberOfFootprint('PS1') && B.memberOfFootprint('PS1')))")
  (constraint clearance (min 2mm))
  (constraint creepage (min 2mm))
)
(rule "divider to L or N"
  (condition "(((A.NetClass == 'MAINS_DIV') && (B.NetClass == 'MAINS_L' || B.NetClass == 'MAINS_N')) || ((A.NetClass == 'MAINS_L' || A.NetClass == 'MAINS_N') && (B.NetClass == 'MAINS_DIV')))")
  (constraint clearance (min 1.5mm))
)
(rule "input to relays"
  (condition "(((A.NetClass == 'MAINS_L' || A.NetClass == 'MAINS_N' || A.NetClass == 'MAINS_DIV') && (B.NetClass == 'RELAY1' || B.NetClass == 'RELAY2')) || ((A.NetClass == 'RELAY1' || A.NetClass == 'RELAY2') && (B.NetClass == 'MAINS_L' || B.NetClass == 'MAINS_N' || B.NetClass == 'MAINS_DIV')))")
  (constraint clearance (min 4mm))
  (constraint creepage (min 4mm))
)
(rule "relay 1 to relay 2"
  (condition "(((A.NetClass == 'RELAY1') && (B.NetClass == 'RELAY2')) || ((A.NetClass == 'RELAY2') && (B.NetClass == 'RELAY1')))")
  (constraint clearance (min 4mm))
  (constraint creepage (min 4mm))
)
(rule "relay contact copper"
  (condition "A.NetClass == 'RELAY1' || A.NetClass == 'RELAY2'")
  (constraint track_width (min 2.5mm))
)
(rule "mains copper to board edge"
  (condition "A.NetClass == 'MAINS_L' || A.NetClass == 'MAINS_N'")
  (constraint edge_clearance (min 0.5mm))
)
